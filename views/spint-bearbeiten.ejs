<%- include('partials/kopf') %>
<%
  const neu = !locker || !locker.id;
  const zurueck = neu ? '/' : '/spint/' + locker.id + '/bearbeiten';
  const ziel = neu ? '/spinte/neu' : '/spint/' + locker.id + '/bearbeiten';
  const mehrereBereiche = areas.length > 1;
%>

<div class="seitenkopf">
  <h1><%= neu ? 'Neuer Spint' : 'Spint ' + locker.code + ' bearbeiten' %></h1>
  <% if (!neu) { %><a class="btn btn-still" href="/spint/<%= locker.id %>">Ansicht</a><% } %>
</div>

<% if (error) { %><p class="hinweis hinweis-warn"><%= error %></p><% } %>

<section class="block">
  <h2>Spint</h2>
  <form method="post" action="<%= ziel %>" class="formraster">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label>
      <span>Nummer *</span>
      <input name="code" value="<%= locker ? (locker.code || '') : vorschlag %>" required maxlength="20" autocomplete="off">
      <small>Steht auf dem Etikett am Spint, z.&nbsp;B. 01</small>
    </label>

    <% if (mehrereBereiche) { %>
      <label>
        <span>Umkleidebereich</span>
        <select name="area_id">
          <% areas.forEach(function (a) { %>
            <option value="<%= a.id %>" <%= a.id === area_id ? 'selected' : '' %>><%= a.name %></option>
          <% }); %>
        </select>
        <small>Die Nummer muss nur innerhalb des Bereichs eindeutig sein.</small>
      </label>
    <% } else if (area_id) { %>
      <input type="hidden" name="area_id" value="<%= area_id %>">
    <% } %>

    <label>
      <span>Besitzer</span>
      <select name="member_id">
        <option value="">— frei —</option>
        <% members.forEach(function (mem) { %>
          <option value="<%= mem.id %>" <%= locker && locker.member_id === mem.id ? 'selected' : '' %>>
            <%= mem.name %><%= mem.gender ? ' (' + GENDER_GROUP[mem.gender] + ')' : '' %>
          </option>
        <% }); %>
      </select>
      <small>
        Angeboten werden Mitglieder ohne eigenen Spint<%= showAreas ? ', passend zum Bereich' : '' %>.
        <a href="/mitglieder">Mitglieder verwalten</a>
      </small>
    </label>

    <label>
      <span>Bezeichnung</span>
      <input name="label" value="<%= locker ? (locker.label || '') : '' %>" maxlength="60">
    </label>

    <label>
      <span>Standort</span>
      <input name="location" value="<%= locker ? (locker.location || '') : '' %>" maxlength="60" placeholder="z. B. Umkleide links">
    </label>

    <label class="breit">
      <span>Notiz</span>
      <textarea name="note" rows="2"><%= locker ? (locker.note || '') : '' %></textarea>
    </label>

    <div class="formfuss breit">
      <button class="btn" type="submit"><%= neu ? 'Spint anlegen' : 'Speichern' %></button>
    </div>
  </form>
</section>

<% if (!neu) { %>
<section class="block">
  <h2>Ausrüstung in diesem Spint</h2>

  <% if (items.length === 0) { %>
    <p class="leer">Noch nichts eingetragen.</p>
  <% } else { %>
    <div class="teilliste">
      <% items.forEach(function (it) { %>
        <div class="teilzeile<%= it.task_id ? ' teilzeile-offen' : '' %>">
          <% if (it.task_id) { %>
            <p class="teilhinweis">
              <%- include('partials/aufgabe', { aufgabe: { kind: it.task_kind, von: it.task_from, nach: it.task_to, seit: it.task_created } }) %>
              <span>seit <%= datum(it.task_created) %><% if (it.task_reason) { %>, Grund: <%= it.task_reason %><% } %></span>
              <a href="/aufgaben">Aufgaben ansehen</a>
            </p>
          <% } %>
          <form method="post" action="/ausruestung/<%= it.id %>/bearbeiten" class="teilform">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="zurueck" value="<%= zurueck %>">

            <select name="type_id" aria-label="Art">
              <% types.forEach(function (t) { %>
                <option value="<%= t.id %>" data-size="<%= t.has_size %>" data-inv="<%= t.has_inventory %>" data-schema="<%= t.size_scheme || '' %>"
                        <%= t.id === it.type_id ? 'selected' : '' %>><%= t.name %></option>
              <% }); %>
              <% if (!types.some(function (t) { return t.id === it.type_id; })) { %>
                <option value="<%= it.type_id %>" selected><%= it.type_name %> (stillgelegt)</option>
              <% } %>
            </select>

            <input name="size" value="<%= it.size || '' %>" placeholder="Größe" aria-label="Größe" size="8">
            <span class="feldpaar">
              <input name="inventory_no" value="<%= it.inventory_no || '' %>" placeholder="Inv.-Nr." aria-label="Inventarnummer" size="12">
              <button class="btn btn-klein btn-still" type="button" data-scan="feld" title="Barcode scannen">📷</button>
            </span>

            <select name="condition" aria-label="Zustand">
              <% ['gut', 'gebraucht', 'defekt'].forEach(function (c) { %>
                <option value="<%= c %>" <%= it.condition === c ? 'selected' : '' %>><%= c %></option>
              <% }); %>
            </select>

            <input name="note" value="<%= it.note || '' %>" placeholder="Notiz" aria-label="Notiz" class="wachsend">
            <button class="btn btn-klein" type="submit">Speichern</button>
          </form>

          <div class="teilaktionen">
            <a class="btn btn-klein btn-still" href="/ausruestung/<%= it.id %>/tauschen">
              <%= it.task_id ? 'Nochmal tauschen / bestellen' : 'Tauschen / Bestellen' %>
            </a>

            <form method="post" action="/ausruestung/<%= it.id %>/verschieben" class="inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="zurueck" value="<%= zurueck %>">
              <select name="ziel" aria-label="Ins Lager legen">
                <option value="lager">→ Lager (ohne Ort)</option>
                <% storagePlaces.forEach(function (s) { %>
                  <option value="lager:<%= s.id %>">→ <%= s.name %></option>
                <% }); %>
              </select>
              <button class="btn btn-klein btn-still" type="submit">OK</button>
            </form>

            <form method="post" action="/ausruestung/<%= it.id %>/ausmustern" class="inline"
                  onsubmit="return confirm('<%= it.type_name %> wirklich ausmustern?');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="zurueck" value="<%= zurueck %>">
              <button class="btn btn-klein btn-gefahr" type="submit">Ausmustern</button>
            </form>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>

  <%# Aufgaben ohne Teil — etwa, wenn das alte Stück als verloren abgehakt wurde. %>
  <% if (lockerTasks && lockerTasks.length) { %>
    <div class="offeneaufgaben">
      <h3>Offen für diesen Spint</h3>
      <ul>
        <% lockerTasks.forEach(function (k) { %>
          <li>
            <%- include('partials/aufgabe', { aufgabe: { kind: k.kind, von: k.from_size, nach: k.to_size, seit: k.created_at } }) %>
            <%= k.type_name || 'Teil' %> — seit <%= datum(k.created_at) %><% if (k.reason) { %>, Grund: <%= k.reason %><% } %>
          </li>
        <% }); %>
      </ul>
      <p class="klein">Steht kein Teil mehr dahinter, weil es verloren oder schon ausgemustert ist.</p>
    </div>
  <% } %>

  <h3>Neues Teil eintragen</h3>
  <form method="post" action="/ausruestung/neu" class="teilform">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="zurueck" value="<%= zurueck %>">
    <input type="hidden" name="locker_id" value="<%= locker.id %>">

    <select name="type_id" required aria-label="Art">
      <option value="">Art wählen …</option>
      <% types.forEach(function (t) { %>
        <option value="<%= t.id %>" data-size="<%= t.has_size %>" data-inv="<%= t.has_inventory %>" data-schema="<%= t.size_scheme || '' %>"><%= t.name %></option>
      <% }); %>
    </select>
    <input name="size" placeholder="Größe" aria-label="Größe" size="8">
    <span class="feldpaar">
      <input name="inventory_no" placeholder="Inv.-Nr." aria-label="Inventarnummer" size="12">
      <button class="btn btn-klein btn-still" type="button" data-scan="feld" title="Barcode scannen">📷</button>
    </span>
    <select name="condition" aria-label="Zustand">
      <option value="gut">gut</option>
      <option value="gebraucht">gebraucht</option>
      <option value="defekt">defekt</option>
    </select>
    <input name="note" placeholder="Notiz" aria-label="Notiz" class="wachsend">
    <button class="btn btn-klein" type="submit">Hinzufügen</button>
  </form>

  <% if (storage.length) { %>
    <h3>Aus dem Lager holen</h3>
    <p class="klein">Ein Klick legt das Teil in diesen Spint.</p>
    <div class="lagerauswahl">
      <% storage.slice(0, 60).forEach(function (s) { %>
        <form method="post" action="/ausruestung/<%= s.id %>/verschieben" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="zurueck" value="<%= zurueck %>">
          <input type="hidden" name="locker_id" value="<%= locker.id %>">
          <button class="tag" type="submit">
            <%= s.type_name %><% if (s.size) { %> · Gr. <%= s.size %><% } %><% if (s.inventory_no) { %> · <%= s.inventory_no %><% } %>
          </button>
        </form>
      <% }); %>
      <% if (storage.length > 60) { %>
        <a class="tag tag-mehr" href="/lager">… <%= storage.length - 60 %> weitere im Lager</a>
      <% } %>
    </div>
  <% } %>
</section>

<section class="block block-gefahr">
  <h2>Spint löschen</h2>
  <p>Die Ausrüstung geht dabei nicht verloren, sie wandert zurück ins Lager.</p>
  <form method="post" action="/spint/<%= locker.id %>/loeschen"
        onsubmit="return confirm('Spint <%= locker.code %> wirklich löschen?');">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn btn-gefahr" type="submit">Spint <%= locker.code %> löschen</button>
  </form>
</section>
<% } %>

<%- include('partials/groessenlisten') %>
<%- include('partials/fuss') %>
