<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %> · <%= stammdaten.organisation %></title>
  <link rel="stylesheet" href="/static/style.css?v=<%= assetVersion %>">
  <%# Zusatz-Stil einzelner Seiten, z.B. das A4-Etikett mit seiner @page-Regel. %>
  <% if (typeof stil !== 'undefined' && stil) { %>
    <link rel="stylesheet" href="/static/<%= stil %>.css?v=<%= assetVersion %>">
  <% } %>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><text y='14' font-size='14'>%F0%9F%9A%92</text></svg>">
</head>
<body>
<header class="topbar">
  <%
    // Marke: Logo der Wehr, solange eines hinterlegt ist — sonst das Kuerzel.
    const marke = stammdaten.hatLogo
      ? `<img class="brand-logo" src="/logo?v=${stammdaten.logoStand}" alt="">`
      : '<span class="brand-mark">JF</span>';
  %>
  <% if (user) { %>
    <a class="brand" href="/">
      <%- marke %>
      <span class="brand-text">
        <span>Spintverwaltung</span>
        <small><%= stammdaten.organisation %></small>
      </span>
    </a>
  <% } else { %>
    <span class="brand">
      <%- marke %>
      <span class="brand-text">
        <span>Spintverwaltung</span>
        <small><%= stammdaten.organisation %></small>
      </span>
    </span>
  <% } %>
  <%# Ohne Anmeldung gibt es keine Navigation — die Seite zeigt dann nur den
      einen Spint bzw. Lagerort, dessen QR-Code gescannt wurde. %>
  <% if (user) { %>
    <nav class="mainnav">
      <a href="/" class="<%= path === '/' ? 'aktiv' : '' %>">Spinte</a>
      <a href="/lager" class="<%= path.startsWith('/lager') ? 'aktiv' : '' %>">Lager</a>
      <a href="/mitglieder" class="<%= path.startsWith('/mitglieder') ? 'aktiv' : '' %>">Mitglieder</a>
      <a href="/ausruestungsarten" class="<%= path.startsWith('/ausruestungsarten') || path.startsWith('/groessen') ? 'aktiv' : '' %>">Arten &amp; Größen</a>
      <a href="/suche" class="<%= path.startsWith('/suche') ? 'aktiv' : '' %>">Suche</a>
      <a href="/aufgaben" class="<%= path.startsWith('/aufgaben') ? 'aktiv' : '' %>">
        Aufgaben<% if (offeneAufgaben) { %> <span class="zaehler"><%= offeneAufgaben %></span><% } %>
      </a>
      <a href="/qr" class="<%= path.startsWith('/qr') ? 'aktiv' : '' %>">QR</a>
      <a href="/verlauf" class="<%= path.startsWith('/verlauf') ? 'aktiv' : '' %>">Verlauf</a>
    </nav>
    <button class="scanknopf" type="button" data-scan="suche" title="Barcode scannen" aria-label="Barcode scannen">📷</button>
  <% } else { %>
    <span class="mainnav"></span>
  <% } %>
  <div class="userbox">
    <% if (user) { %>
      <details class="menu">
        <summary><%= user.name %><% if (isJugendwart) { %> <span class="chip chip-jw">JW</span><% } %></summary>
        <div class="menu-inhalt">
          <a href="/lagerorte">Lagerorte</a>
          <a href="/ausruestungsarten">Ausrüstungsarten</a>
          <a href="/ausgemustert">Ausgemustert</a>
          <a href="/etiketten">Spint-Etiketten</a>
          <% if (isJugendwart) { %>
            <a href="/bereiche">Umkleidebereiche</a>
            <a href="/betreuer">Betreuer verwalten</a>
            <a href="/stammdaten">Stammdaten &amp; Logo</a>
            <a href="/sicherung">Datensicherung</a>
            <a href="/api-zugaenge">API-Zugänge</a>
            <a href="/system">System</a>
          <% } %>
          <a href="/passwort">Passwort ändern</a>
          <form method="post" action="/abmelden">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="link">Abmelden</button>
          </form>
        </div>
      </details>
    <% } else { %>
      <a class="btn btn-klein" href="/anmelden">Anmelden</a>
    <% } %>
  </div>
</header>

<main class="inhalt">
<% if (flash) { %>
  <p class="hinweis hinweis-<%= flash.type %>"><%= flash.text %></p>
<% } %>
