<%- include('partials/kopf') %>
<%
  // Nach dem Speichern soll die Filterung erhalten bleiben.
  const filterTeile = [];
  if (search) filterTeile.push('q=' + encodeURIComponent(search));
  if (typeId) filterTeile.push('art=' + encodeURIComponent(typeId));
  if (ort) filterTeile.push('ort=' + encodeURIComponent(ort));
  const zurueck = '/lager' + (filterTeile.length ? '?' + filterTeile.join('&') : '');
%>

<div class="seitenkopf">
  <h1>Lager</h1>
  <span class="klein"><%= items.length %> Teile</span>
  <a class="btn btn-still" href="/lagerorte">Lagerorte</a>
  <% if (erfassen) { %><a class="btn btn-klein btn-still" href="#bestand">↓ Bestand ansehen</a><% } %>
</div>

<%#
  Der Erfassungsmodus (Schalter auf /lagerorte) entscheidet, wie prominent das
  Einbuchen steht. An: offen ganz oben — beim Aufnehmen des Materials ist das
  die Aufgabe. Aus: nur eingeklappt, der Bestand hat Vorrang. Beide Fassungen
  teilen sich dasselbe Formular-Partial.
%>
<% if (erfassen) { %>
  <section class="block">
    <h2>Einbuchen</h2>
    <%- include('partials/einbuchen', { zurueck }) %>
  </section>
  <h2 id="bestand" class="klein" style="margin:1.5rem 0 .5rem;color:var(--gedaempft)">Bestand</h2>
<% } else { %>
  <details class="block einbuchen-klapp">
    <summary>Material einbuchen</summary>
    <div class="einbuchen-inhalt"><%- include('partials/einbuchen', { zurueck }) %></div>
    <p class="klein">
      Der Erfassungsmodus ist aus. Soll das Einbuchen wieder oben stehen, unter
      <a href="/lagerorte">Lagerorte</a> „Material erfassen“ einschalten.
    </p>
  </details>
<% } %>

<% if (storages.length) { %>
  <div class="kacheln kacheln-schmal">
    <% storages.forEach(function (s) { %>
      <a class="kachel kachel-lager <%= String(s.id) === String(ort) ? 'kachel-aktiv' : '' %>" href="/lager?ort=<%= s.id %>">
        <div class="kachel-kopf">
          <span class="kachel-nr"><%= s.name %></span>
          <span class="kachel-anzahl"><%= s.item_count %></span>
        </div>
        <% if (s.location) { %><div class="kachel-ort"><%= s.location %></div><% } %>
      </a>
    <% }); %>
    <a class="kachel kachel-lager <%= ort === 'ohne' ? 'kachel-aktiv' : '' %>" href="/lager?ort=ohne">
      <div class="kachel-kopf"><span class="kachel-nr">Ohne Ort</span></div>
      <div class="kachel-ort">noch nicht einsortiert</div>
    </a>
  </div>
<% } %>

<form method="get" action="/lager" class="filterleiste">
  <input name="q" value="<%= search %>" placeholder="Größe, Inv.-Nr. oder Art" aria-label="Suchen">
  <button class="btn btn-klein btn-still" type="button" data-scan="feld" data-ziel="input[name='q']" data-absenden>📷 Scannen</button>
  <select name="art" aria-label="Art">
    <option value="">alle Arten</option>
    <% types.forEach(function (t) { %>
      <option value="<%= t.id %>" <%= String(t.id) === String(typeId) ? 'selected' : '' %>><%= t.name %></option>
    <% }); %>
  </select>
  <select name="ort" aria-label="Lagerort">
    <option value="">alle Orte</option>
    <% storages.forEach(function (s) { %>
      <option value="<%= s.id %>" <%= String(s.id) === String(ort) ? 'selected' : '' %>><%= s.name %></option>
    <% }); %>
    <option value="ohne" <%= ort === 'ohne' ? 'selected' : '' %>>ohne Ort</option>
  </select>
  <label class="kasten">
    <input type="checkbox" name="groesse" value="fehlt" <%= ohneGroesse ? 'checked' : '' %> onchange="this.form.submit()">
    nur ohne Größe
  </label>
  <button class="btn btn-klein" type="submit">Filtern</button>
  <% if (search || typeId || ort || ohneGroesse) { %><a class="btn btn-klein btn-still" href="/lager">zurücksetzen</a><% } %>
</form>

<% if (ohneGroesseAnzahl > 0 && !ohneGroesse) { %>
  <p class="hinweis hinweis-warn">
    <%= ohneGroesseAnzahl %> <%= ohneGroesseAnzahl === 1 ? 'Teil führt eine Größe, hat aber keine' : 'Teile führen eine Größe, haben aber keine' %> hinterlegt —
    z.&nbsp;B. Handschuhe ohne Etikett. <a href="/lager?groesse=fehlt">Diese anzeigen</a> und nachtragen.
  </p>
<% } %>

<% if (items.length === 0) { %>
  <p class="leer">Keine passenden Teile im Lager.</p>
<% } else { %>
  <%# Jede Zeile ist bearbeitbar — sonst käme man an Größe und Inventarnummer
      eines Teils, das im Lager liegt, gar nicht heran. %>
  <div class="teilliste">
    <% items.forEach(function (it) { %>
      <% const groesseFehlt = it.has_size && !(it.size && it.size.trim()); %>
      <div class="teilzeile <%= it.condition === 'defekt' ? 'zeile-defekt' : '' %> <%= groesseFehlt ? 'zeile-ohne-groesse' : '' %>">
        <% if (groesseFehlt) { %><p class="teilhinweis"><span class="chip chip-fehlt">Größe fehlt</span> noch nachtragen</p><% } %>
        <form method="post" action="/ausruestung/<%= it.id %>/bearbeiten" class="teilform">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="zurueck" value="<%= zurueck %>">

          <select name="type_id" aria-label="Art">
            <% types.forEach(function (t) { %>
              <option value="<%= t.id %>" data-size="<%= t.has_size %>" data-inv="<%= t.has_inventory %>" data-schema="<%= t.size_scheme || '' %>"
                      <%= t.id === it.type_id ? 'selected' : '' %>><%= t.name %></option>
            <% }); %>
            <% if (!types.some(function (t) { return t.id === it.type_id; })) { %>
              <option value="<%= it.type_id %>" selected><%= it.type_name %> (stillgelegt)</option>
            <% } %>
          </select>

          <input name="size" value="<%= it.size || '' %>" placeholder="Größe" aria-label="Größe" size="8">
          <span class="feldpaar">
            <input name="inventory_no" value="<%= it.inventory_no || '' %>" placeholder="Inv.-Nr." aria-label="Inventarnummer" size="12">
            <button class="btn btn-klein btn-still" type="button" data-scan="feld" title="Barcode scannen">📷</button>
          </span>

          <select name="condition" aria-label="Zustand">
            <% ['gut', 'gebraucht', 'defekt'].forEach(function (c) { %>
              <option value="<%= c %>" <%= it.condition === c ? 'selected' : '' %>><%= c %></option>
            <% }); %>
          </select>

          <input name="note" value="<%= it.note || '' %>" placeholder="Notiz" aria-label="Notiz" class="wachsend">
          <button class="btn btn-klein" type="submit">Speichern</button>
        </form>

        <div class="teilaktionen">
          <form method="post" action="/ausruestung/<%= it.id %>/verschieben" class="inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="zurueck" value="<%= zurueck %>">
            <select name="ziel" aria-label="Verschieben nach">
              <optgroup label="Lagerorte">
                <% storages.forEach(function (s) { %>
                  <option value="lager:<%= s.id %>" <%= s.id === it.storage_id ? 'selected' : '' %>><%= s.name %></option>
                <% }); %>
                <option value="lager" <%= it.storage_id ? '' : 'selected' %>>ohne Ort</option>
              </optgroup>
              <optgroup label="Spinte">
                <% lockers.forEach(function (l) { %>
                  <option value="spint:<%= l.id %>">Spint <%= l.code %><%= showAreas && l.area_name ? ' · ' + l.area_name : '' %></option>
                <% }); %>
              </optgroup>
            </select>
            <button class="btn btn-klein btn-still" type="submit" title="Dorthin verschieben">→</button>
          </form>

          <form method="post" action="/ausruestung/<%= it.id %>/ausmustern" class="inline"
                onsubmit="return confirm('<%= it.type_name %><%= it.inventory_no ? ' ' + it.inventory_no : '' %> wirklich ausmustern?');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="zurueck" value="<%= zurueck %>">
            <button class="btn btn-klein btn-gefahr" type="submit">Ausmustern</button>
          </form>
        </div>
      </div>
    <% }); %>
  </div>
<% } %>

<%- include('partials/groessenlisten') %>
<%- include('partials/fuss') %>
