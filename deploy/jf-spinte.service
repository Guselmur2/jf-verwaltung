[Unit]
Description=Spintverwaltung Jugendfeuerwehr
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@BENUTZER@
Group=@BENUTZER@
WorkingDirectory=@ORDNER@
Environment=NODE_ENV=production
Environment=PORT=443
Environment=HOST=0.0.0.0
Environment=DATA_DIR=@ORDNER@/data
Environment=TLS_KEY=@ORDNER@/tls/pi.key
Environment=TLS_CERT=@ORDNER@/tls/pi.crt
Environment=BASE_URL=https://@ADRESSE@
Environment=SESSION_SECRET=@GEHEIMNIS@
ExecStart=/usr/bin/node @ORDNER@/server.js
Restart=always
RestartSec=5

# Port 443 ohne Root-Rechte binden duerfen
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Absicherung: der Dienst darf nur in sein eigenes Datenverzeichnis schreiben
# und keine zusaetzlichen Rechte erlangen. NoNewPrivileges ist der Grund, warum
# das Herunterfahren ueber polkit laeuft und nicht ueber sudo — siehe
# deploy/49-jf-spinte-poweroff.rules.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@ORDNER@/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
