<%- include('partials/kopf') %>

<div class="seitenkopf">
  <h1>Arten &amp; Größen</h1>
</div>

<p class="klein">
  Legt fest, was beim Eintragen abgefragt wird: welche Ausrüstungsarten es gibt, welche Größen dazu
  gehören und mit welchem Anfang ihre Barcodes beginnen. Eine stillgelegte Art verschwindet aus den
  Auswahllisten, vorhandene Teile bleiben unangetastet.
</p>

<div class="tabellenrahmen">
  <table class="tabelle">
    <thead>
      <tr><th>Name</th><th>Größe</th><th>Inv.-Nr.</th><th>Reihenfolge</th><th>Teile</th><th></th></tr>
    </thead>
    <tbody>
      <% types.forEach(function (t) { %>
        <tr class="<%= t.active ? '' : 'zeile-inaktiv' %>">
          <td colspan="4" data-label="Art">
            <form method="post" action="/ausruestungsarten/<%= t.id %>/bearbeiten" class="teilform">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input name="name" value="<%= t.name %>" required aria-label="Name" class="wachsend">
              <label class="kasten"><input type="checkbox" name="has_size" value="1" <%= t.has_size ? 'checked' : '' %>> Größe</label>
              <label class="kasten"><input type="checkbox" name="has_inventory" value="1" <%= t.has_inventory ? 'checked' : '' %>> Inv.-Nr.</label>
              <select name="size_scheme" aria-label="Größenschema">
                <option value="">— freie Größen —</option>
                <% schemes.forEach(function (s) { %>
                  <option value="<%= s.name %>" <%= t.size_scheme === s.name ? 'selected' : '' %>><%= s.label %></option>
                <% }); %>
              </select>
              <input name="barcode_prefix" value="<%= t.barcode_prefix || '' %>" placeholder="Barcode-Präfix"
                     aria-label="Barcode-Präfix" size="12" autocomplete="off">
              <input type="number" name="barcode_digits" value="<%= t.barcode_digits || '' %>" min="1" max="12"
                     placeholder="Stellen" aria-label="Stellen" style="width:5.5rem">
              <input type="number" name="sort_order" value="<%= t.sort_order %>" aria-label="Reihenfolge" size="4" style="width:5rem">
              <button class="btn btn-klein" type="submit">Speichern</button>
            </form>
          </td>
          <td data-label="Teile"><%= t.count %></td>
          <td data-label="Aktion" class="zeilenaktionen">
            <form method="post" action="/ausruestungsarten/<%= t.id %>/status" class="inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-klein btn-still" type="submit"><%= t.active ? 'Stilllegen' : 'Aktivieren' %></button>
            </form>
            <% if (isJugendwart && t.count === 0) { %>
              <form method="post" action="/ausruestungsarten/<%= t.id %>/loeschen" class="inline"
                    onsubmit="return confirm('Art &quot;<%= t.name %>&quot; löschen?');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-klein btn-gefahr" type="submit">Löschen</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<section class="block">
  <h2>Barcode-Präfix</h2>
  <p class="klein">
    Steht auf allen Etiketten einer Art derselbe Anfang — im Gerätehaus etwa
    <code>KKJF.1202.</code> bei den Helmen und <code>112000</code> bei Jacken und Hosen —, trägt man
    ihn oben je Art ein. Wird dann nur der hintere Teil eingetippt, ergänzt die Software den Anfang:
    <code>172</code> wird zu <code>112000172</code>.
  </p>
  <p class="klein">
    <strong>Stellen</strong> füllt den eingetippten Rest mit Nullen auf. Bei Präfix <code>112000</code>
    und 3 Stellen wird aus <code>12</code> die Nummer <code>112000012</code>. Bleibt das Feld leer,
    wird nichts aufgefüllt und die Ergänzung greift bis drei Stellen.
    Gescannte Nummern bleiben immer unverändert.
  </p>
</section>

<section class="block">
  <h2>Größen</h2>
  <p class="klein">
    Legt fest, welche Größen es je Ausrüstungsart gibt. Wird beim Erfassen eine Größe eingetippt,
    die hier nicht steht, fragt die Software nach und schlägt die nächstliegende vor.
    <strong>Die Reihenfolge zählt</strong> — sie bestimmt, was „eine Nummer größer“ ist.
  </p>

  <% schemes.forEach(function (s) { %>
    <div class="schemablock">
      <h3>
        <%= s.label %>
        <span class="klein"><code><%= s.name %></code></span>
        <% if (isJugendwart && !types.some(function (t) { return t.size_scheme === s.name; })) { %>
          <form method="post" action="/groessen/<%= s.name %>/loeschen" class="inline"
                onsubmit="return confirm('Größenschema „<%= s.label %>“ löschen?');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-klein btn-gefahr" type="submit">Löschen</button>
          </form>
        <% } %>
      </h3>
      <% if (s.note) { %><p class="klein"><%= s.note %></p><% } %>
      <form method="post" action="/groessen/<%= s.name %>/speichern" class="formstapel">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <%
          const gruppen = [];
          s.sizes.forEach(function (g) {
            let eintrag = gruppen.find(function (x) { return x.gruppe === (g.gruppe || ''); });
            if (!eintrag) { eintrag = { gruppe: g.gruppe || '', werte: [] }; gruppen.push(eintrag); }
            eintrag.werte.push(g.wert);
          });
          if (!gruppen.length) gruppen.push({ gruppe: 'Größen', werte: [] });
        %>
        <% gruppen.forEach(function (g) { %>
          <label>
            <span><%= g.gruppe || 'Größen' %></span>
            <input name="werte_<%= g.gruppe %>" value="<%= g.werte.join(', ') %>" autocomplete="off">
          </label>
        <% }); %>
        <div class="formfuss">
          <button class="btn btn-klein" type="submit">Größen speichern</button>
        </div>
      </form>
    </div>
  <% }); %>

  <h3>Neues Größenschema</h3>
  <p class="klein">
    Nötig, wenn zwei Arten unterschiedliche Reihen haben — Jacken werden oft als
    <code>146/152</code> geführt, Hosen derselben Wehr als <code>152/158</code>.
    Eine Zeile je Gruppe, Größen durch Komma getrennt.
  </p>
  <form method="post" action="/groessen/neu" class="formstapel">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="formraster">
      <label>
        <span>Kurzname</span>
        <input name="name" placeholder="jacke" required pattern="[a-z0-9][a-z0-9-]{1,30}" autocomplete="off">
        <small>Kleinbuchstaben, Ziffern, Bindestrich</small>
      </label>
      <label>
        <span>Bezeichnung</span>
        <input name="bezeichnung" placeholder="Jacke (Doppelgrößen / Konfektion)">
      </label>
    </div>
    <label>
      <span>Größen</span>
      <textarea name="groessen" rows="3" placeholder="Körpergröße: 122/128, 134/140, 146/152&#10;Konfektion: 44, 46, 48"></textarea>
    </label>
    <label>
      <span>Hinweis (optional)</span>
      <input name="hinweis" placeholder="wofür dieses Schema gilt">
    </label>
    <div class="formfuss">
      <button class="btn btn-klein" type="submit">Schema anlegen</button>
    </div>
  </form>
</section>

<section class="block">
  <h2>Neue Art</h2>
  <form method="post" action="/ausruestungsarten/neu" class="teilform">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input name="name" placeholder="z. B. Nomex-Haube" required aria-label="Name" class="wachsend">
    <label class="kasten"><input type="checkbox" name="has_size" value="1" checked> Größe</label>
    <label class="kasten"><input type="checkbox" name="has_inventory" value="1" checked> Inv.-Nr.</label>
    <select name="size_scheme" aria-label="Größenschema">
      <option value="">— freie Größen —</option>
      <% schemes.forEach(function (s) { %>
        <option value="<%= s.name %>"><%= s.label %></option>
      <% }); %>
    </select>
    <input name="barcode_prefix" placeholder="Barcode-Präfix" aria-label="Barcode-Präfix" size="12" autocomplete="off">
    <input type="number" name="barcode_digits" min="1" max="12" placeholder="Stellen" aria-label="Stellen" style="width:5.5rem">
    <input type="number" name="sort_order" value="100" aria-label="Reihenfolge" style="width:5rem">
    <button class="btn btn-klein" type="submit">Anlegen</button>
  </form>
</section>

<%- include('partials/fuss') %>
